<view class="container data-v-aa5cff34"><view class="header data-v-aa5cff34"><text class="title data-v-aa5cff34">上传文件</text></view><view class="upload-section data-v-aa5cff34"><view wx:if="{{a}}" class="upload-area data-v-aa5cff34" bindtap="{{b}}"><view class="upload-icon data-v-aa5cff34">📁</view><text class="upload-text data-v-aa5cff34">点击选择文件</text><text class="upload-hint data-v-aa5cff34">支持大文件上传（最大支持 10GB）</text></view><view wx:if="{{c}}" class="file-info data-v-aa5cff34"><view class="file-item data-v-aa5cff34"><text class="file-name data-v-aa5cff34">{{d}}</text><text class="file-size data-v-aa5cff34">{{e}}</text></view><button class="upload-btn data-v-aa5cff34" bindtap="{{f}}" disabled="{{g}}">开始上传</button></view><view wx:if="{{h}}" class="upload-progress data-v-aa5cff34"><view class="progress-info data-v-aa5cff34"><text class="progress-text data-v-aa5cff34">上传中...</text><text class="progress-percent data-v-aa5cff34">{{i}}%</text></view><progress class="data-v-aa5cff34" percent="{{j}}" stroke-width="8" color="#667eea"/><text class="progress-detail data-v-aa5cff34">已上传: {{k}} / {{l}}</text></view><view wx:if="{{m}}" class="pickup-code-section data-v-aa5cff34"><view class="success-icon data-v-aa5cff34">✅</view><text class="success-title data-v-aa5cff34">上传成功！</text><view class="pickup-code-box data-v-aa5cff34"><text class="pickup-label data-v-aa5cff34">取件码</text><text class="pickup-code data-v-aa5cff34" bindtap="{{o}}">{{n}}</text><text class="pickup-hint data-v-aa5cff34">点击复制取件码，分享给需要下载的用户</text></view><button class="back-btn data-v-aa5cff34" bindtap="{{p}}">返回首页</button></view></view></view>